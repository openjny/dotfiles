# .zshrc

# ------------------------------------
# Sheldon (plugin manager) — static source for speed
# ------------------------------------
if command -v sheldon &>/dev/null; then
  sheldon_cache="${XDG_CACHE_HOME:-$HOME/.cache}/sheldon/source.zsh"
  sheldon_toml="${XDG_CONFIG_HOME:-$HOME/.config}/sheldon/plugins.toml"
  if [[ ! -r "$sheldon_cache" || "$sheldon_toml" -nt "$sheldon_cache" ]]; then
    mkdir -p "${sheldon_cache:h}"
    sheldon source > "$sheldon_cache"
  fi
  source "$sheldon_cache"
  unset sheldon_cache sheldon_toml
fi

# ------------------------------------
# Zsh settings (split files)
# ------------------------------------
for zsh_file in "$HOME/.zsh"/*.zsh(N); do
  source "$zsh_file"
done

# ------------------------------------
# Local overrides
# ------------------------------------
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
