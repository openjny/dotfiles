{{ if eq .profile "desktop" -}}
#!/bin/bash
# Install desktop-specific apt packages that can't be managed by Nix
# (kernel integration, daemon services, GPU drivers, etc.)
#
# This runs once on first chezmoi apply.
# To re-run: chezmoi state delete-bucket --bucket=scriptState

set -euo pipefail

packages=(
  # Container runtime (needs systemd + kernel)
  docker-ce
  docker-ce-cli
  containerd.io
  docker-buildx-plugin
  docker-compose-plugin

  # Input method
  fcitx5-mozc

  # Clipboard (Wayland)
  wl-clipboard
  wtype
  xdotool
)

# Check if Docker repo is configured
if ! apt-cache policy docker-ce 2>/dev/null | grep -q docker.com; then
  echo "Adding Docker repository..."
  sudo install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  sudo chmod a+r /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
  sudo apt-get update
fi

echo "Installing desktop apt packages..."
sudo apt-get install -y "${packages[@]}"

# Add user to docker group if not already
if ! groups | grep -q docker; then
  sudo usermod -aG docker "$USER"
  echo "Added $USER to docker group (re-login required)"
fi

echo "Desktop apt packages installed"
{{ end -}}
