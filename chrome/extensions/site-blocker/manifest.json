{
    "manifest_version": 3,
    "name": "Site Blocker",
    "version": "1.0",
    "description": "指定したサイトをブロックするChrome拡張機能",
    "permissions": [
        "storage",
        "declarativeNetRequest",
        "declarativeNetRequestFeedback"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    }
}
